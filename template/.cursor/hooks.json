{
  "version": 1,
  "hooks": {
    "stop": [
      {
        "command": "node .cursor/hooks/request-review.mjs",
        "loop_limit": 2
      }
    ],
    "subagentStart": [
      {
        "command": "node .cursor/hooks/review-visible.mjs",
        "matcher": "sdd-reviewer"
      }
    ],
    "subagentStop": [
      {
        "command": "node .cursor/hooks/review-finished.mjs",
        "matcher": "sdd-reviewer",
        "loop_limit": 1
      }
    ],
    "beforeReadFile": [
      {
        "command": "node .cursor/hooks/normalize-md-guard.mjs"
      }
    ]
  }
}
