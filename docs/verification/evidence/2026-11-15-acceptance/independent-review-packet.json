  "requirements": [
    {
      "id": "R1",
      "text": "delivery v2 links confirmed requirements/AC to cases, environments and scheduled checks; v1 cannot acquire new acceptance from historical successes.",
      "status": "confirmed",
      "basis": [
        "M0"
      ]
    },
    {
      "id": "R2",
      "text": "Task DONE requires every current attempt check; final scope is rerun against the final candidate and direct controller calls cannot bypass readiness.",
      "status": "confirmed",
      "basis": [
        "M0"
      ]
    },
    {
      "id": "R3",
      "text": "Case evidence must match a complete raw Playwright report, file, ID and environment; skips, flaky, missing/ambiguous results, wrong mock/live scope cannot pass.",
      "status": "confirmed",
      "basis": [
        "M0"
      ]
    },
    {
      "id": "R4",
      "text": "Execution captures inputs before, verifies after and at consumption; latest failure/interruption supersedes older pass; records persist before ledger references and recover without replay.",
      "status": "confirmed",
      "basis": [
        "M0"
      ]
    },
    {
      "id": "R5",
      "text": "Automatic readiness admits final review while manual confirmation remains pending; final approval/completion requires real recorded candidate-bound evidence and independent re-review.",
      "status": "confirmed",
      "basis": [
        "M0"
      ]
    },
    {
      "id": "R6",
      "text": "Independent review must use direct evidence mapping and cannot fill missing rules from another pass; known faults fail at the intended browser assertion.",
      "status": "confirmed",
      "basis": [
        "M0"
      ]
    },
    {
      "id": "R7",
      "text": "Proposal section 7.2: repair in the current phase, review repaired tasks before whole-feature re-verification/final review, retain maxFixRounds accounting across attempts and do not bypass final human authority.",
      "status": "confirmed",
      "basis": [
        "M0"
      ]
    },
    {
      "id": "R8",
      "text": "Proposal section 5.2: spec requires source-backed observable ACs and method; plan adds complete cases/checks/environments; spec rendering must not require future plan/test files.",
      "status": "confirmed",
      "basis": [
        "M0"
      ]
    }
  ],
